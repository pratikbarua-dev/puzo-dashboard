# PUZO backend (proxied through the BFF)
PUZO_API_BASE=http://localhost:8080
# Admin key used server-side for admin-only backend routes that still accept x-admin-key
ADMIN_API_KEY=change-me-admin-key

# Supabase project (must match the PUZO backend's Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser (used for the SSE realtime feed)
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth (Google OAuth)
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-better-auth-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth database (Postgres). Generate tables with: npx auth migrate
DATABASE_URL=postgres://user:password@host:5432/dbname
