# PUZO backend (proxied through the BFF)
PUZO_API_BASE=http://localhost:8080
# Admin key used server-side for admin-only backend routes that still accept x-admin-key
ADMIN_API_KEY=change-me-admin-key

# Supabase project (must match the PUZO backend's Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser (used for the SSE realtime feed)
SUPABASE_SERVICE_ROLE_KEY=

# BFF session encryption secret (base64, 32+ bytes). Generate: openssl rand -base64 32
SESSION_SECRET=change-me-session-secret
